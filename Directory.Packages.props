    <PackageVersion Include="EnvDTE90" Version="17.14.40260" />
    <PackageVersion Include="Microsoft.VisualStudio.CommandBars" Version="17.14.40260" />
    <PackageVersion Include="Microsoft.VisualStudio.ComponentModelHost" Version="17.14.106" />
    <PackageVersion Include="Microsoft.VisualStudio.Editor" Version="17.14.249" />
    <PackageVersion Include="Microsoft.VisualStudio.Imaging.Interop.14.0.DesignTime" Version="17.14.40254" />
    <PackageVersion Include="Microsoft.VisualStudio.Language.Intellisense" Version="17.14.249" />
    <PackageVersion Include="Microsoft.VisualStudio.Shell.15.0" Version="17.14.40264" />
    <PackageVersion Include="Microsoft.VisualStudio.Shell.Interop" Version="17.14.40260" />
    <PackageVersion Include="Microsoft.VisualStudio.Shell.Interop.10.0" Version="17.14.40260" />
    <PackageVersion Include="Microsoft.VisualStudio.Shell.Interop.11.0" Version="17.14.40260" />
    <PackageVersion Include="Microsoft.VisualStudio.Shell.Interop.8.0" Version="17.14.40260" />
    <PackageVersion Include="Microsoft.VisualStudio.Validation" Version="17.13.22" />
    <PackageVersion Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="stdole" Version="17.14.40260" />
    <PackageVersion Include="StreamJsonRpc" Version="2.25.29" />
    <PackageVersion Include="System.Collections.Immutable" Version="9.0.0" />
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />
    <PackageVersion Include="System.Reflection.Emit" Version="4.7.0" />
    <PackageVersion Include="System.Runtime" Version="4.3.1" />
    <PackageVersion Include="System.Runtime.WindowsRuntime" Version="4.7.0" />
