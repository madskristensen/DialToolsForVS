<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- The path of Windows.WinMD below is built from this version; the CI build replaces it with the newest Windows SDK of the runner -->
    <TargetPlatformVersion>10.0.28000.0</TargetPlatformVersion>
    <!-- The output stays in bin\<Configuration>\, as before, where the build workflow looks for the VSIX -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The assembly attributes, the WPF theme info among them, are in Properties\AssemblyInfo.cs and come from the manifest -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Label="VSIX">
    <!-- Sets the defaults of an SDK-style extension: the VSIX container, the Content items in it, F5 into the Experimental instance -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <VsixDeployOnDebug>true</VsixDeployOnDebug>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets Visual Studio recognize the project as an extension before the first restore has imported the build tools -->
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <!-- The files are included by the globs of the SDK; this adds the metadata that Visual Studio needs for the designers, the generators and the nesting -->
  <ItemGroup>
    <Compile Update="CustomOptions.cs" SubType="Component" />
    <Compile Update="CustomOptionsControl.cs" SubType="UserControl" />
    <Compile Update="CustomOptionsControl.Designer.cs" DependentUpon="CustomOptionsControl.cs" />
    <Compile Update="Options.cs" SubType="Component" />
    <Compile Update="source.extension.cs" DependentUpon="source.extension.vsixmanifest" />
    <Compile Update="VSCommandTable.cs" AutoGen="True" DesignTime="True" DependentUpon="VSCommandTable.vsct" />
    <EmbeddedResource Update="source.extension.resx" AutoGen="True" DesignTime="True" DependentUpon="source.extension.vsixmanifest" MergeWithCTO="true" ManifestResourceName="VSPackage" />
    <None Update="source.extension.ico" DependentUpon="source.extension.vsixmanifest" />
    <None Update="source.extension.vsixmanifest" SubType="Designer" Generator="VsixManifestGenerator" LastGenOutput="source.extension.resx" />
  </ItemGroup>

  <ItemGroup>
    <AvailableItemName Include="VSCTCompile" />
    <None Remove="VSCommandTable.vsct" />
    <VSCTCompile Include="VSCommandTable.vsct" ResourceName="Menus.ctmenu" Generator="VsctGenerator" LastGenOutput="VSCommandTable.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content goes into the VSIX: VSSDKBuildToolsAutoSetup sets IncludeInVSIX for it. The glob picks up the icon of every Dial menu item -->
    <Content Include="..\LICENSE" Link="Resources\LICENSE" />
    <Content Include="Providers\**\icon.png" />
    <Content Include="Resources\Icon.png" />
    <EmbeddedResource Include="Resources\commands.txt" />
    <None Remove="Providers\**\icon.png" />
    <None Remove="Resources\commands.txt" />
    <None Remove="Resources\Icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private assemblies of the Visual Studio that builds the extension: see "Private Visual Studio Assemblies" in the instructions. They must not be copied into the VSIX -->
    <Reference Include="Microsoft.VisualStudio.Diagnostics.Assert">
      <HintPath>$(MSBuildExtensionsPath)\..\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.Diagnostics.Assert.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Platform.WindowManagement">
      <HintPath>$(MSBuildExtensionsPath)\..\Common7\IDE\Microsoft.VisualStudio.Platform.WindowManagement.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.UI.Internal">
      <HintPath>$(MSBuildExtensionsPath)\..\Common7\IDE\Microsoft.VisualStudio.Shell.UI.Internal.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.ViewManager">
      <HintPath>$(MSBuildExtensionsPath)\..\Common7\IDE\Microsoft.VisualStudio.Shell.ViewManager.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Windows">
      <HintPath>$(MSBuildProgramFiles32)\Windows Kits\10\UnionMetadata\$(TargetPlatformVersion)\Windows.WinMD</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Framework assemblies that the SDK does not reference by default -->
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Community.VisualStudio.Toolkit.17" />
    <PackageReference Include="EnvDTE" />
    <PackageReference Include="EnvDTE100" />
    <PackageReference Include="EnvDTE80" />
    <PackageReference Include="EnvDTE90" />
    <PackageReference Include="Microsoft.VisualStudio.CommandBars" />
    <PackageReference Include="Microsoft.VisualStudio.ComponentModelHost" />
    <PackageReference Include="Microsoft.VisualStudio.Editor" />
    <PackageReference Include="Microsoft.VisualStudio.Imaging.Interop.14.0.DesignTime" />
    <PackageReference Include="Microsoft.VisualStudio.Language.Intellisense" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.Interop" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.Interop.10.0" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.Interop.11.0" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.Interop.8.0" />
    <PackageReference Include="Microsoft.VisualStudio.Validation" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="stdole" />
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="System.Net.Http" />
    <PackageReference Include="System.Reflection.Emit" />
    <PackageReference Include="System.Runtime" />
    <PackageReference Include="System.Runtime.WindowsRuntime" />
    <PackageReference Include="System.Security.Cryptography.Algorithms" />
    <PackageReference Include="System.Security.Cryptography.X509Certificates" />
    <PackageReference Include="System.ValueTuple" />
  </ItemGroup>

</Project>
